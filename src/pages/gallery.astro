---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';

// Import all portrait images
import portrait1 from '../assets/portraits/1.jpg';
import portrait2 from '../assets/portraits/2.jpg';
import portrait3 from '../assets/portraits/3.jpg';
import portrait4 from '../assets/portraits/4.jpg';
import portrait5 from '../assets/portraits/5.jpg';
import portrait6 from '../assets/portraits/6.jpg';

const portraits = [
	{ img: portrait1, alt: "Pet portrait artwork" },
	{ img: portrait2, alt: "Pet portrait artwork" },
	{ img: portrait3, alt: "Pet portrait artwork" },
	{ img: portrait4, alt: "Pet portrait artwork" },
	{ img: portrait5, alt: "Pet portrait artwork" },
	{ img: portrait6, alt: "Pet portrait artwork" },
];
---

<Layout title="Gallery | Melina Martins Art">
	<Header />
	
	<main>
		<section class="container mx-auto px-6 py-16">
			<h2 class="text-4xl md:text-5xl font-bold text-center mb-12 text-pink-500">
				Gallery
			</h2>
			
			<div class="masonry-grid">
				{portraits.map((portrait) => (
					<div class="masonry-item p-2">
						<Image 
							src={portrait.img} 
							alt={portrait.alt}
							class="rounded-lg shadow-md hover:shadow-xl transition-shadow duration-300"
							loading="lazy"
						/>
					</div>
				))}
			</div>
		</section>
	</main>

	<Footer />
</Layout>

<style>
	.masonry-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		grid-gap: 16px;
	}

	@media (min-width: 768px) {
		.masonry-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 1024px) {
		.masonry-grid {
			grid-template-columns: repeat(3, 1fr);
			column-gap: 24px;
			row-gap: 24px;
		}
	}

	.masonry-item {
		break-inside: avoid;
		margin-bottom: 16px;
	}

	.masonry-item img {
		width: 100%;
		height: auto;
		display: block;
	}
</style>