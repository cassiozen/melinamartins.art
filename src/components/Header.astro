---
---

<header class="header">
  <div class="container">
    <h1>Melina Martins Art</h1>
    <p class="tagline">Pet Portrait Artist</p>
  </div>
</header>

<style>
  .header {
    padding: var(--space-6) 0;
    margin-bottom: var(--space-5);
  }
  
  .header h1 {
    margin: 0;
    font-size: 3.5rem;
    text-align: center;
    color: var(--color-brown-800);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.1);
  }
  
  .tagline {
    text-align: center;
    color: var(--color-gray-600);
    font-size: 1.25rem;
    margin-top: var(--space-2);
    font-style: italic;
  }
  
  @media (max-width: 768px) {
    .header {
      padding: var(--space-5) 0;
    }
    
    .header h1 {
      font-size: 2.5rem;
    }
    
    .tagline {
      font-size: 1rem;
    }
  }
</style>
