---
import { Image } from 'astro:assets';
import pencils from '../assets/portraits/1.jpg';
import charcoal from '../assets/portraits/6.jpg';
---

<section id="materials" class="py-16 bg-gray-100">
  <div class="container mx-auto px-6">
    <h2 class="text-2xl md:text-3xl text-gray-900 mb-6">Materials and Style</h2>
    <p class="mb-8 text-gray-700 leading-relaxed">
      I love to make art that reflects both a pet's personality and their owner's.
      When commissioning a portrait, please choose between colored pencils for a
      more realistic style or charcoal for dramatic contrasts.
    </p>
    <div class="grid md:grid-cols-2 gap-8">
      <div class="bg-white rounded-lg shadow-lg overflow-hidden flex flex-col lg:flex-row">
        <Image
          src={pencils}
          alt="Colored pencil portrait sample"
          class="w-fit lg:w-64 lg:h-80 object-cover"
        />
        <div class="p-6">
          <h3 class="text-2xl font-semibold mb-2">Colored Pencil</h3>
          <p class="text-gray-700">Vibrant, realistic portraits with fine detail and rich colors.</p>
        </div>
      </div>
      <div class="bg-white rounded-lg shadow-lg overflow-hidden flex flex-col lg:flex-row">
        <Image
          src={charcoal}
          alt="Charcoal portrait sample"
          class="w-fit lg:w-64 lg:h-80 object-cover"
        />
        <div class="p-6">
          <h3 class="text-2xl font-semibold mb-2">Charcoal</h3>
          <p class="text-gray-700">Dramatic, moody portraits with strong contrasts and expressive lines.</p>
        </div>
      </div>
    </div>
  </div>
</section>
