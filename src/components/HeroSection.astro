---

import { Image } from 'astro:assets';
import myImage from '../assets/portraits/5.jpg';
---

<section id="hero" class="bg-gradient-to-r from-pink-300 via-red-300 to-yellow-300 text-white py-20">
  <div class="container mx-auto px-6 flex flex-col-reverse md:flex-row items-center">
    <div class="md:w-1/2 text-center md:text-left">
      <h2 class="text-4xl md:text-5xl font-bold mb-4">Meet Linguini</h2>
      <p class="mb-6 text-lg md:text-xl">
        This is my dog, Linguini, a gentle and loving rough collie who loves slow
        sniff walks and frolicking in the snow.
      </p>
    </div>
    <div class="md:w-1/2 mb-8 md:mt-0 flex justify-center">
      <Image src={myImage}
        
        alt="Portrait of Linguini"
        class="rounded-lg shadow-lg w-96 h-96 object-cover"
      />
    </div>
  </div>
</section>
