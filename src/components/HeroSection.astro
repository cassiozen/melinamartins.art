<section class="hero section">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-image">
        <img 
          src="https://images.pexels.com/photos/5732532/pexels-photo-5732532.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=2" 
          alt="Portrait of a dog" 
          class="portrait"
        />
      </div>
      <div class="hero-content">
        <h2>Meet Linguini</h2>
        <p class="hero-text">
          This is my dog, Linguini, a gentle and loving rough collie who loves slow sniff walks and frolicking in the snow.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: var(--space-6);
  }
  
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    align-items: center;
  }
  
  .hero-image {
    position: relative;
    border: 8px solid var(--color-neutral-50);
    box-shadow: var(--shadow-lg);
    transform: rotate(-2deg);
    transition: transform var(--transition);
    max-width: 90%;
    margin: 0 auto;
  }
  
  .hero-image:hover {
    transform: rotate(0deg);
  }
  
  .portrait {
    display: block;
    width: 100%;
    height: auto;
  }
  
  .hero-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  
  .hero-text {
    font-size: 1.25rem;
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }
  
  @media (min-width: 768px) {
    .hero-grid {
      grid-template-columns: 1fr 1fr;
    }
    
    .hero-image {
      max-width: 100%;
    }
  }
</style>