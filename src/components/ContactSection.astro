---
import Button from "./Button.astro";
---

<section id="contact" class="py-16 bg-white">
  <div class="container mx-auto px-6 text-center">
    <h2 class="text-3xl md:text-4xl text-gray-900 mb-4">Ready to Book?</h2>
    <p class="text-gray-700 mb-6">Send me an email and let's turn your pet into art.</p>
    <Button
      href="mailto:book@melinamartins.art"
      text="Book a Commission"
      variant="primary"
    />
  </div>
</section>
