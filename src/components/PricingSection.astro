    </div>
  </div>
</section>

<style>
  .pricing h2 {
    text-align: center;
    position: relative;
    margin-bottom: var(--space-4);
  }
  
  .pricing h2:after {
    content: '';
    display: block;
    width: 80px;
    height: 3px;
    background-color: var(--color-accent-500);
    margin: var(--space-2) auto 0;
  }
  
  .pricing-content {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }
  
  .pricing-note {
    font-style: italic;
    color: var(--color-neutral-600);
    font-size: 1.2rem;
  }
</style>