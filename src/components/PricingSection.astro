---

---

<section id="pricing" class="py-16 bg-white">
  <div
    class="container mx-auto px-6 text-center"
  >
  <h2 class="text-2xl md:text-3xl text-gray-900 mb-4">Pricing</h2>
  <div class="flex flex-col-reverse md:flex-row items-center md:gap-14">
    <div class="md:w-1/2 text-left grow">
      <p class="mb-6 text-lg md:text-xl">
        Sizing is based on standard frame sizes that are easy to find, so you
        won't need to order a custom frame for your pet portrait.<br />
        If you'd like to order a different size, please contact me.
        <br />
        <span class="text-sm font-semibold">Delivery costs not included.</span>
      </p>
    </div>
    <div class="max-w-md w-full my-8 md:flex-1/3">
      <table class="w-full border-collapse">
        <thead>
          <tr>
            <th class="py-3 border-b-2 border-gray-300 text-left">Size</th>
            <th class="py-3 border-b-2 border-gray-300 text-right">Price</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="py-3 border-b border-gray-200 text-left">4x6</td>
            <td class="py-3 border-b border-gray-200 text-right">$120</td>
          </tr>
          <tr>
            <td class="py-3 border-b border-gray-200 text-left">9x12</td>
            <td class="py-3 border-b border-gray-200 text-right">$175</td>
          </tr>
          <tr>
            <td class="py-3 border-b border-gray-200 text-left">16x20</td>
            <td class="py-3 border-b border-gray-200 text-right">$300</td>
          </tr>
          <tr>
            <td class="py-3 border-b border-gray-200 text-left">24x36</td>
            <td class="py-3 border-b border-gray-200 text-right">$400</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>
